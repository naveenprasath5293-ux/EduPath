# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/student_course_management

# Auth (Phase 2) - single httpOnly-cookie JWT approach
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=token
AUTH_COOKIE_MAX_AGE_MS=86400000

# Used only by scripts/seedAdmin.js to bootstrap the first admin account
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@edupath.com
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=0000000000
